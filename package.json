{
  "name": "yc-auto-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev workers/index.ts --local",
    "build": "vite build",
    "preflight:deploy": "tsx scripts/preflight-deploy.ts",
    "deploy": "npm run preflight:deploy && CLOUDFLARE_ENV=production npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply yc-auto-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply yc-auto-prod --remote --env production",
    "db:seed:local": "tsx scripts/seed-local.ts",
    "migrate:legacy:dry": "tsx scripts/migrate-legacy.ts dry",
    "migrate:legacy:prepare": "tsx scripts/migrate-legacy.ts prepare",
    "migrate:legacy:apply": "tsx scripts/migrate-legacy.ts apply",
    "migrate:legacy:verify": "tsx scripts/migrate-legacy.ts verify",
    "verify:prod": "tsx scripts/verify-production.ts",
    "bootstrap:cloudflare": "tsx scripts/bootstrap-cloudflare.ts"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/space-grotesk": "^5.2.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.12",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
